# Local API keys — never commit
google key.txt
*api*key*.txt

# Godot 4
.godot/
*.translation
export.cfg
export_presets.cfg
.import/
*.tmp

# GitHub rejects blobs over 100 MB. Keep these on disk only.
assets/incoming/gltf.zip
assets/incoming/roads/gltf.zip
assets/incoming/*.zip
assets/incoming/**/*.zip
assets/incoming/old_city.glb

# Blender autosave. The .blend file is the source.
*.blend1

# Local editor config
.mcp.json

# Python bytecode
__pycache__/
*.pyc

# Large raw OSM downloads (regenerate with tools/); keep *_game.json
assets/maps/*.osm.xml
assets/maps/*.osm.json
!assets/maps/*_game.json
!assets/maps/MUMBAI_ATTRIBUTION.txt
*.osm.pbf
*.mbtiles

# Blender MCP clone / local tooling (optional large)
tools/blender_mcp/
tools/blender_mcp_1.0.3/

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Exports
build/
*.apk
*.aab
*.ipa
*.exe
*.pck
addons/ziva/
