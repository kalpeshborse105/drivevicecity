extends Node3D
## Isolated Mumbai Fort OSM road prototype — roads + kerbs/sidewalks + buildings.
## Does NOT touch Dhule. Does NOT use mumbai_city.glb for roads.
##
## Road network: real OSM centerlines (assets/maps/mumbai_fort_roads_game.json).
## Buildings: NO OSM footprints exist in the source data (highways-only Overpass
## clip), so buildings are generated by a documented frontage rule — never inside
## the road corridor. Placement is validated against ALL roads, not just the one
## being fronted, so buildings cannot block junctions or cross-streets.

signal map_ready(spawn_position: Vector3, spawn_heading: Vector2, anchors: Array)

const StreetKit = preload("res://scripts/street_kit.gd")
const AssetKit = preload("res://scripts/asset_kit.gd")
const BuildingKit = preload("res://scripts/building_kit.gd")

## Sidewalk / building clearance (metres)
const SIDEWALK_W := 2.4      ## sidewalk width baked beside roads >= SIDEWALK_MIN_W
const SIDEWALK_MIN_W := 6.0  ## roads narrower than this get no sidewalk
const KERB_H := 0.14
const BUILD_SETBACK := 2.2   ## gap between sidewalk outer edge and building front wall
const BUILD_PROJECTION := 1.4## max balcony/awning depth that projects past the wall
const BUILD_RADIUS := 330.0  ## only dress streets within this radius of spawn
const COLLIDE_RADIUS := 300.0## only near-spawn buildings get collision bodies
const BUILDING_CAP := 260
const TREE_CAP := 110
const GRID := 24.0           ## spatial-hash cell size for road / building lookups

@export_file("*.json") var map_json_path: String = "res://assets/maps/mumbai_fort_roads_game.json"
@export var road_y: float = 0.04

var spawn_position: Vector3 = Vector3(0, 0.55, 0)
var spawn_heading: Vector2 = Vector2(0, -1)
var road_segment_count: int = 0
var junction_count: int = 0
var building_count: int = 0
var building_colliders: int = 0
var tree_count: int = 0

var _asphalt: StandardMaterial3D
var _major: StandardMaterial3D
var _edge: StandardMaterial3D
var _sidewalk: StandardMaterial3D
var _road_samples: Array[Vector3] = []
var _frontages: Array = []

## Spatial hash: cell -> Array[Vector3(x, half_width, z)] for road clearance.
var _road_grid: Dictionary = {}
## Spatial hash: cell -> Array[Rect2] for placed building footprints (xz).
var _placed_grid: Dictionary = {}


func _ready() -> void:
	if not FileAccess.file_exists(map_json_path):
		push_error("Mumbai map JSON missing: %s" % map_json_path)
		return
	var file := FileAccess.open(map_json_path, FileAccess.READ)
	var data: Variant = JSON.parse_string(file.get_as_text())
	file.close()
	if typeof(data) != TYPE_DICTIONARY:
		push_error("Invalid Mumbai game JSON")
		return
	_build(data as Dictionary)
	call_deferred("_emit_ready")


func _emit_ready() -> void:
	map_ready.emit(spawn_position, spawn_heading, [])


func _mat(color: Color, rough: float = 0.9) -> StandardMaterial3D:
	return StreetKit.mat(color, rough)


func _build(data: Dictionary) -> void:
	_asphalt = _kit_or_flat("street_road", Color(0.24, 0.24, 0.26), 0.9)
	_major = _kit_or_flat("avenue_street", Color(0.22, 0.22, 0.24), 0.86)
	_edge = _mat(Color(0.9, 0.9, 0.87), 0.7)
	_sidewalk = _mat(Color(0.64, 0.61, 0.56), 0.93)

	var clip := float(data.get("clip_radius_m", 900.0))
	_add_ground(clip)

	var rng := RandomNumberGenerator.new()
	rng.seed = 20261030

	var roads: Array = data.get("roads", [])
	junction_count = int(data.get("junction_clusters_approx", 0))
	_road_grid.clear()
	_frontages.clear()
	for road_v in roads:
		var road: Dictionary = road_v
		var pts: Array = road.get("points", [])
		if pts.size() < 2:
			continue
		var width: float = float(road.get("width", 7.0))
		var hw: String = str(road.get("highway", "residential"))
		var is_major := hw in ["primary", "secondary", "trunk", "motorway", "tertiary"]
		var mat := _major if is_major else _asphalt
		road_segment_count += _build_road_strip(pts, width, mat, is_major)

	if data.has("spawn"):
		var s: Dictionary = data["spawn"]
		spawn_position = Vector3(float(s.get("x", 0)), 0.55, float(s.get("z", 0)))
		spawn_heading = Vector2(float(s.get("hx", 0)), float(s.get("hz", -1)))
	elif not roads.is_empty():
		var p0: Array = (roads[0] as Dictionary)["points"][0]
		spawn_position = Vector3(float(p0[0]), 0.55, float(p0[1]))

	BuildingKit.signature_budget = 48
	_add_buildings(rng)
	_add_street_trees(rng)
	StreetKit.flush_trees(self)

	print(
		"MUMBAI_PROTO map: roads=%d segs=%d junctions~%d buildings=%d colliders=%d trees=%d spawn=(%.1f,%.1f) attr=%s"
		% [
			roads.size(),
			road_segment_count,
			junction_count,
			building_count,
			building_colliders,
			tree_count,
			spawn_position.x,
			spawn_position.z,
			str(data.get("attribution", "")),
		]
	)


func _kit_or_flat(kit_key: String, tint: Color, rough: float) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_color = tint
	m.roughness = rough
	var tex := AssetKit.road_albedo_clean(kit_key)
	if tex:
		m.albedo_texture = tex
		m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	return m


func _add_ground(clip: float) -> void:
	var size := clip * 2.2
	var ground := _mat(Color(0.42, 0.41, 0.37), 0.96)
	StreetKit.add_box(self, Vector3(size, 1.0, size), Vector3(0, -0.5, 0), ground, true)


func _build_road_strip(pts: Array, width: float, mat: Material, is_major: bool) -> int:
	var n := 0
	var tile_m := 12.0 if is_major else 10.0
	var sw := SIDEWALK_W if width >= SIDEWALK_MIN_W else 0.0
	var i := 0
	while i < pts.size() - 1:
		var a0: Array = pts[i]
		var b0: Array = pts[i + 1]
		var p_start := Vector3(float(a0[0]), road_y, float(a0[1]))
		var p_next := Vector3(float(b0[0]), road_y, float(b0[1]))
		var d0 := p_next - p_start
		var len0 := d0.length()
		if len0 < 0.5:
			i += 1
			continue
		var dir0 := d0 / len0
		# Merge nearly colinear short segments into one deck
		var p_end := p_next
		var j := i + 1
		var run_len := len0
		while j < pts.size() - 1 and run_len < 28.0:
			var a1: Array = pts[j]
			var b1: Array = pts[j + 1]
			var q0 := Vector3(float(a1[0]), road_y, float(a1[1]))
			var q1 := Vector3(float(b1[0]), road_y, float(b1[1]))
			var dj := q1 - q0
			var lj := dj.length()
			if lj < 0.4:
				j += 1
				continue
			var dirj := dj / lj
			if dir0.dot(dirj) < 0.92:
				break
			p_end = q1
			run_len += lj
			j += 1
		var delta := p_end - p_start
		var length := delta.length()
		if length < 0.5:
			i = maxi(j, i + 1)
			continue
		var dir := delta / length
		var mid := p_start + dir * (length * 0.5)
		var yaw := atan2(dir.x, dir.z)
		var deck_len := length + 0.35
		# Baked surface: asphalt + edge lines (+ centre dashes on majors) + sidewalks.
		# Kerbs/sidewalks/edge paint live in this ONE mesh — no extra nodes per segment.
		StreetKit.add_road_deck(
			self,
			width,
			deck_len,
			mid,
			yaw,
			mat,
			tile_m,
			true,
			_edge,
			_sidewalk if sw > 0.0 else null,
			sw,
			KERB_H,
			is_major
		)
		# Matching collision — top near road surface (identical to the verified prototype)
		StreetKit.add_box(
			self,
			Vector3(width * 0.98, 0.28, deck_len),
			mid + Vector3(0, -0.12, 0),
			mat,
			true,
			yaw
		)
		var half := width * 0.5
		# Obstruction radius = road half-width + baked sidewalk, so clearance is
		# measured from the sidewalk's outer edge (buildings never sit on either).
		var obst := half + sw
		# Sample the corridor every ~8 m (not just the deck midpoint) so clearance
		# checks stay accurate near deck ends and at junctions.
		var n_samples := maxi(1, int(ceil(length / 8.0)))
		for s in range(n_samples + 1):
			var sp := p_start + dir * (length * float(s) / float(n_samples))
			_road_samples.append(Vector3(sp.x, half, sp.z))
			_road_grid_add(sp.x, sp.z, obst)
		_frontages.append({
			"mid": mid,
			"dir": dir,
			"len": length,
			"width": width,
			"sw": sw,
		})
		n += 1
		i = maxi(j, i + 1)
	return n


# ---------------------------------------------------------------- road clearance

func _cell(x: float, z: float) -> Vector2i:
	return Vector2i(floori(x / GRID), floori(z / GRID))


func _road_grid_add(x: float, z: float, half: float) -> void:
	var key := _cell(x, z)
	if not _road_grid.has(key):
		_road_grid[key] = []
	(_road_grid[key] as Array).append(Vector3(x, half, z))


func _road_edge_clearance(x: float, z: float) -> float:
	## Distance from (x,z) to the nearest road EDGE (centerline dist − corridor half).
	## Corridor = asphalt half-width + sidewalk. Large when no road is near.
	var best := 100000.0
	var c := _cell(x, z)
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			var key := c + Vector2i(dx, dz)
			if not _road_grid.has(key):
				continue
			for s_v in _road_grid[key]:
				var s: Vector3 = s_v
				var d := sqrt((x - s.x) * (x - s.x) + (z - s.z) * (z - s.z)) - s.y
				if d < best:
					best = d
	return best


func _asphalt_edge_clearance(x: float, z: float) -> float:
	## Distance to asphalt edge only (ignores sidewalk strip). For street-tree sites.
	var best := 100000.0
	for s_v in _road_samples:
		var s: Vector3 = s_v
		var d := sqrt((x - s.x) * (x - s.x) + (z - s.z) * (z - s.z)) - s.y
		if d < best:
			best = d
	return best


func _all_points_clear(points: Array) -> bool:
	## True when every probe point is at least 0.5 m outside every road corridor
	## (corridor = road half-width + sidewalk). Probes already include projection.
	for p_v in points:
		var p: Vector3 = p_v
		if _road_edge_clearance(p.x, p.z) < 0.5:
			return false
	return true


static func _footprint_probes(center: Vector3, fwd: Vector3, bw: float, bd: float) -> Array:
	## Centre + 4 rotated corners of the building footprint (fwd = building depth axis).
	var rgt := Vector3(fwd.z, 0.0, -fwd.x)
	var hw2 := bw * 0.5
	var hd2 := bd * 0.5
	return [
		center,
		center + rgt * hw2 + fwd * hd2,
		center - rgt * hw2 + fwd * hd2,
		center + rgt * hw2 - fwd * hd2,
		center - rgt * hw2 - fwd * hd2,
	]


func _footprint_free(x: float, z: float, hx: float, hz: float) -> bool:
	## True when the xz rect does not overlap an already-placed building.
	var r := Rect2(Vector2(x - hx - 0.6, z - hz - 0.6), Vector2(hx * 2 + 1.2, hz * 2 + 1.2))
	var c := _cell(x, z)
	for dx in range(-1, 2):
		for dz in range(-1, 2):
			var key := c + Vector2i(dx, dz)
			if not _placed_grid.has(key):
				continue
			for o_v in _placed_grid[key]:
				if r.intersects(o_v):
					return false
	return true


func _footprint_reserve(x: float, z: float, hx: float, hz: float) -> void:
	var key := _cell(x, z)
	if not _placed_grid.has(key):
		_placed_grid[key] = []
	(_placed_grid[key] as Array).append(Rect2(Vector2(x - hx, z - hz), Vector2(hx * 2, hz * 2)))


# ---------------------------------------------------------------- buildings

func _add_buildings(rng: RandomNumberGenerator) -> void:
	## Documented frontage method: walk each road deck within BUILD_RADIUS of spawn
	## and place buildings on both sides, front (glazing) toward the street. Every
	## candidate is rejected unless it clears ALL roads by (footprint + setback +
	## sidewalk + margin) and does not overlap an existing footprint. This keeps
	## junctions and cross-streets open without needing OSM footprints (none exist).
	var clip_guard := 880.0
	var frontages := _frontages.duplicate()
	for k in range(frontages.size() - 1, 0, -1):
		var r := rng.randi_range(0, k)
		var tmp: Variant = frontages[k]
		frontages[k] = frontages[r]
		frontages[r] = tmp
	var spawn_xz := Vector2(spawn_position.x, spawn_position.z)
	var radius_sq := BUILD_RADIUS * BUILD_RADIUS
	for f_v in frontages:
		if building_count >= BUILDING_CAP:
			break
		var f: Dictionary = f_v
		var mid: Vector3 = f["mid"]
		if spawn_xz.distance_squared_to(Vector2(mid.x, mid.z)) > radius_sq:
			continue
		var dir: Vector3 = f["dir"]
		var length: float = float(f["len"])
		var width: float = float(f["width"])
		var sw: float = float(f["sw"])
		var side_normal := Vector3(-dir.z, 0.0, dir.x)
		var front_offset := width * 0.5 + sw + BUILD_SETBACK
		var along := -length * 0.5 + 2.0
		while along < length * 0.5 - 2.0:
			if building_count >= BUILDING_CAP:
				break
			var bw := rng.randf_range(7.0, 12.5)
			var bd := rng.randf_range(7.0, 11.0)
			var gap := rng.randf_range(1.2, 3.2)
			var along_pos := mid + dir * along
			for side in [-1.0, 1.0]:
				if building_count >= BUILDING_CAP:
					break
				var center: Vector3 = along_pos + side_normal * (float(side) * (front_offset + bd * 0.5))
				if absf(center.x) > clip_guard or absf(center.z) > clip_guard:
					continue
				if spawn_xz.distance_to(Vector2(center.x, center.z)) < 18.0:
					continue
				var face_dir: Vector3 = side_normal * (-float(side))
				# Whole ROTATED footprint (corners + centre) must clear ALL road corridors.
				# Inflate the depth axis by the max projection so overhangs also clear.
				var probes: Array = _footprint_probes(center, face_dir, bw + 0.5, bd + BUILD_PROJECTION * 2.0)
				if not _all_points_clear(probes):
					continue
				# World-space AABB of the rotated footprint — used for overlap + reserve.
				var minx := center.x
				var maxx := center.x
				var minz := center.z
				var maxz := center.z
				for p_v in probes:
					var p: Vector3 = p_v
					minx = minf(minx, p.x)
					maxx = maxf(maxx, p.x)
					minz = minf(minz, p.z)
					maxz = maxf(maxz, p.z)
				var cx := (minx + maxx) * 0.5
				var cz := (minz + maxz) * 0.5
				var ahx := (maxx - minx) * 0.5
				var ahz := (maxz - minz) * 0.5
				if not _footprint_free(cx, cz, ahx, ahz):
					continue
				var with_col := spawn_xz.distance_to(Vector2(center.x, center.z)) < COLLIDE_RADIUS
				var kind := "commercial" if rng.randf() < 0.42 else "residential"
				BuildingKit.footprint(
					self,
					Vector3(center.x, 0.0, center.z),
					Vector2(bw, bd),
					kind,
					hash(Vector2i(int(round(center.x)), int(round(center.z)))),
					face_dir,
					with_col
				)
				_footprint_reserve(cx, cz, ahx, ahz)
				building_count += 1
				if with_col:
					building_colliders += 1
			along += bw + gap


func _add_street_trees(rng: RandomNumberGenerator) -> void:
	## Street trees on the sidewalk strip (batched MultiMesh + trunk colliders).
	## Trunks stay off asphalt and out of building footprints; canopy may overhang kerb.
	var spawn_xz := Vector2(spawn_position.x, spawn_position.z)
	for f_v in _frontages:
		if tree_count >= TREE_CAP:
			break
		var f: Dictionary = f_v
		var mid: Vector3 = f["mid"]
		if spawn_xz.distance_to(Vector2(mid.x, mid.z)) > BUILD_RADIUS * 0.7:
			continue
		var dir: Vector3 = f["dir"]
		var length: float = float(f["len"])
		var width: float = float(f["width"])
		var sw: float = float(f["sw"])
		if sw <= 0.0 or length < 12.0:
			continue
		var side_normal := Vector3(-dir.z, 0.0, dir.x)
		# One or two sites along longer decks
		var along_offsets: Array[float] = [0.0]
		if length > 20.0:
			along_offsets = [-length * 0.28, length * 0.28]
		for ao in along_offsets:
			if tree_count >= TREE_CAP:
				break
			var base: Vector3 = mid + dir * ao
			for side in [-1.0, 1.0]:
				if tree_count >= TREE_CAP:
					break
				if rng.randf() > 0.55:
					continue
				# Mid-sidewalk: clear of asphalt, in front of building setback.
				var t: Vector3 = base + side_normal * (float(side) * (width * 0.5 + sw * 0.55))
				if spawn_xz.distance_to(Vector2(t.x, t.z)) < 14.0:
					continue
				# Must sit past the asphalt edge (≥0.4 m onto the sidewalk).
				if _asphalt_edge_clearance(t.x, t.z) < 0.4:
					continue
				# Not inside a building (tight probe — sidewalk trees sit in the setback gap).
				if not _footprint_free(t.x, t.z, 1.2, 1.2):
					continue
				StreetKit.tree(self, Vector3(t.x, 0.0, t.z), rng)
				tree_count += 1
				_footprint_reserve(t.x, t.z, 1.5, 1.5)
