[input_devices]

pointing/android/enable_long_press_as_right_click=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.88, 1)

[shader_globals]

building_night={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
